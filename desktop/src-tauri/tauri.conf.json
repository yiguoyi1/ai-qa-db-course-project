{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI QA Community",
  "version": "0.1.0",
  "identifier": "com.aiqa.community.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI QA Community",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI QA desktop client",
    "longDescription": "A desktop client for the AI QA community backed by the existing FastAPI service."
  }
}
